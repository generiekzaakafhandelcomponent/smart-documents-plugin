{
    "$id": "example.schema",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Example",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "Name, sent to SmartDocuments as template data"
        },
        "message": {
            "type": "string",
            "description": "Free text, sent to SmartDocuments as template data"
        },
        "opgevraagdeStukken": {
            "type": "array",
            "description": "Requested documents, sent to SmartDocuments as a list",
            "items": {
                "type": "object",
                "properties": {
                    "omschrijving": {
                        "type": "string"
                    },
                    "toelichting": {
                        "type": "string"
                    }
                }
            }
        },
        "templateGroup": {
            "type": "string",
            "description": "SmartDocuments template group"
        },
        "templateName": {
            "type": "string",
            "description": "SmartDocuments template name"
        },
        "format": {
            "type": "string",
            "enum": [
                "DOCX",
                "HTML",
                "PDF",
                "XML"
            ],
            "description": "Format of the generated document"
        },
        "payloadFormat": {
            "type": "string",
            "enum": [
                "JSON",
                "XML"
            ],
            "description": "Payload format of the generate-document action"
        },
        "templateNames": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Template names returned by the get-template-names action"
        },
        "generatedDocumentResourceId": {
            "type": "string",
            "description": "Id of the temporary resource created by the generate-document action"
        },
        "storedDocumentUrl": {
            "type": "string",
            "description": "URL of the document stored in the Documenten API"
        }
    }
}
