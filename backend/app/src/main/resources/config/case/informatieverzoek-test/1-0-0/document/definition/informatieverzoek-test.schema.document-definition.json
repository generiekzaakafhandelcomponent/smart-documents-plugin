{
    "$id": "informatieverzoek-test.schema",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Informatieverzoek (test)",
    "type": "object",
    "properties": {
        "templateGroup": {
            "type": "string"
        },
        "templateName": {
            "type": "string"
        },
        "format": {
            "type": "string",
            "enum": [
                "DOCX",
                "HTML",
                "PDF",
                "XML"
            ]
        },
        "payloadFormat": {
            "type": "string",
            "enum": [
                "JSON",
                "XML"
            ]
        },
        "zaaknummer": {
            "type": "string"
        },
        "gegevensAanvrager": {
            "type": "object"
        },
        "gegevensPartner": {
            "type": [
                "object",
                "null"
            ]
        },
        "verzendadres": {
            "type": "object"
        },
        "verzenddatum": {
            "type": "string"
        },
        "datumAanvraag": {
            "type": "string"
        },
        "deadlineInformatieverzoek": {
            "type": "string"
        },
        "opgevraagdeStukken": {
            "type": "array",
            "items": {
                "type": "object"
            }
        },
        "hersteltermijn": {
            "type": "string"
        },
        "generatedDocumentResourceId": {
            "type": "string"
        },
        "storedDocumentUrl": {
            "type": "string"
        }
    }
}
