{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "@valtimo-plugins/smartdocuments": {
            "projectType": "library",
            "root": "projects/plugin",
            "sourceRoot": "projects/plugin/src",
            "prefix": "lib",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:ng-packagr",
                    "options": {
                        "tsConfig": "projects/plugin/tsconfig.lib.json",
                        "project": "projects/plugin/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/plugin/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/plugin/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "projects/plugin/src/test.ts",
                        "tsConfig": "projects/plugin/tsconfig.spec.json",
                        "karmaConfig": "projects/plugin/karma.conf.js"
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "projects/plugin/src/**/*.ts",
                            "projects/plugin/src/**/*.html"
                        ]
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": false
    }
}
